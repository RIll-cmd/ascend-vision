# Setup.bat asks for this and writes .env for you. Copy this file only if you prefer to do it by hand.
GEMINI_API_KEY=your_gemini_api_key_here

# --- Optional extras (leave blank) -------------------------------------
# A second AI provider used automatically if Gemini is unavailable.
GROQ_API_KEY=
CEREBRAS_API_KEY=

# Ascend Core account link (shows your missions and agent status).
ASCEND_CORE_BASE_URL=http://localhost:8000
ASCEND_VISION_TOKEN=
ASCEND_BASE_URL=http://localhost:8000
ASCEND_API_TOKEN=
ASCEND_DEVICE_ID=ascend-vision-desktop
ASCEND_CHARACTER_ID=

# Phone chat worker; keep phone_chat.enabled=false in config.yaml until all are provisioned.
ASCEND_PHONE_CORE_URL=
ASCEND_PHONE_WORKER_TOKEN=
ASCEND_PHONE_OWNER_ID=
